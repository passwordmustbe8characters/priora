# Copy this file to .env.local (gitignored) and fill in real values.
# Never commit .env.local or paste real keys into chat.

OPENAI_API_KEY=

# Postgres connection string (Vercel Postgres / Neon). Grab it from
# Vercel dashboard -> project -> Storage tab.
DATABASE_URL=

# Optional. Days a cached company record is considered fresh before the
# Caching Layer falls back to a live search. Defaults to 30 if unset.
# COMPANY_CACHE_TTL_DAYS=30

# Required to call POST /api/admin/ingest. Pick any long random string
# yourself (e.g. `openssl rand -hex 32`) — sent as `Authorization: Bearer
# <value>` when triggering an ingestion run.
ADMIN_SECRET=

# Optional — only needed for the Product Hunt source connector. Create a
# free app at https://www.producthunt.com/v2/oauth/applications, then
# generate a "Developer Token" on that app's page (no OAuth flow needed
# for read-only server-side use). Leave blank to skip Product Hunt —
# ingestion just reports that source as unavailable.
PRODUCT_HUNT_API_TOKEN=
